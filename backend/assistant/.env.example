# Copy to .env (ignored by git) or export these before running.
# Language model: Claude (ANTHROPIC_API_KEY) or NVIDIA (NVIDIA_API_KEY, OpenAI-compatible).
# With only NVIDIA_API_KEY set, NVIDIA is used. Force one with LLM_PROVIDER=anthropic|nvidia.
ANTHROPIC_API_KEY=
NVIDIA_API_KEY=
# LLM_PROVIDER=nvidia
# NVIDIA_MODEL=meta/llama-3.3-70b-instruct
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Optional overrides
# ASSISTANT_MODEL=claude-opus-5-5
# ASSISTANT_EFFORT=low
# KNOWLEDGE_DIR=../knowledge
# CROP_CALENDAR=../data/crop-calendar.json
