DATABASE_URL=postgresql://greenloop:change-me-db@localhost:5432/greenloop
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=greenloop
MQTT_PASSWORD=change-me-mqtt

# Login for the dashboard. Login is disabled while the password is empty.
API_ADMIN_USER=admin
API_ADMIN_PASSWORD=
# Signs login tokens; generate with: python -c "import secrets; print(secrets.token_hex(32))"
API_SECRET_KEY=
API_TOKEN_HOURS=720
# Optional fixed token for services such as the alert bot or the assistant.
API_SERVICE_TOKEN=

MAX_PUMP_S=900
PUMP_NODES=irrigation-1
OFFLINE_AFTER_S=600
CORS_ORIGINS=http://localhost:5173
