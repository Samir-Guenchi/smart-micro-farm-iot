# Copy to .env and fill in. .env is ignored by git; never commit real values.
# Each service also has its own .env.example next to it with only what it needs.

# MQTT broker (Mosquitto in backend/)
MQTT_HOST=localhost
MQTT_PORT=1883
# true for hosted brokers (HiveMQ Cloud, EMQX); automatic on port 8883
MQTT_TLS=false
MQTT_USERNAME=greenloop
MQTT_PASSWORD=change-me

# Time-series database (Postgres + TimescaleDB)
DATABASE_URL=postgresql://greenloop:change-me@localhost:5432/greenloop

# Backend REST API
API_BASE_URL=http://localhost:8000/api
API_TOKEN=

# Telegram alerts and agent approvals
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# AI assistant and farm agent (Claude API)
ANTHROPIC_API_KEY=

# Farm location for sunrise/sunset and weather (decimal degrees)
FARM_LAT=56.95
FARM_LON=24.11
