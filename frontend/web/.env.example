# Where the farm API lives (backend/api). Leave empty to use the built-in mock data.
VITE_API_BASE=http://localhost:8000
# Force the mock even when VITE_API_BASE is set (e.g. for a public demo build).
VITE_USE_MOCK=false
# Web push public key (VAPID). Push stays off until it is set.
VITE_VAPID_PUBLIC_KEY=
# Optional default farm location for the water plan and plant health (farmers can also set it in the app).
VITE_FARM_LAT=
VITE_FARM_LON=
# Currency shown in the Farm book and water cost (default DA).
VITE_CURRENCY=
