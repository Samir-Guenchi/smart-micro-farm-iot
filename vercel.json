{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "assistant/static",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{web,site,assets,backend,ml,docs,agent,.github}/**"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
