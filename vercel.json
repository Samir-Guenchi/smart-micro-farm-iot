{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "backend/assistant/static",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{frontend,assets,ml,docs,.github,backend/agent,backend/alerts,backend/api,backend/db,backend/grafana,backend/ingest,backend/mosquitto,backend/weather}/**"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
