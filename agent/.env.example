# Copy to .env (ignored by git). Never commit real values.
# Language model: Claude (ANTHROPIC_API_KEY) or NVIDIA (NVIDIA_API_KEY, OpenAI-compatible).
# With only NVIDIA_API_KEY set, NVIDIA is used. Force one with LLM_PROVIDER=anthropic|nvidia.
ANTHROPIC_API_KEY=
NVIDIA_API_KEY=
# LLM_PROVIDER=nvidia
# NVIDIA_MODEL=meta/llama-3.3-70b-instruct
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
API_BASE_URL=http://localhost:8000/api
API_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
FARM_LAT=56.95
FARM_LON=24.11
# Optional
# AGENT_MODEL=claude-opus-5-5
# AGENT_EFFORT=medium
# AGENT_LOG=data/decisions.jsonl
